# Groq API key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ─── GOOGLE SHEETS ────────────────────────────────────────────────────────────
# ID du Google Sheet (visible dans l'URL : /d/VOTRE_ID/edit)
SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# Nom de l'onglet cible
SHEET_ONGLET=BODACC

# Chemin vers le fichier JSON du compte de service Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Optional: path to Chromium if not using Playwright's bundled version
# CHROMIUM_PATH=/usr/bin/chromium-browser
